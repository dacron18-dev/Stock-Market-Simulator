    status = EXECUTED
}

object "transaction : Transaction" as transaction {
    transactionId = 12001
    type = BUY
    quantity = 10
    executionPrice = 2500.00
}

trader -- account
trader -- portfolio
portfolio -- holding
holding -- stock

trader -- order
order -- stock
order -- account
order -- portfolio
order -- transaction

@enduml
