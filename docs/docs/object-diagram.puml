    companyName = "Reliance Industries"
    currentPrice = 2500.00
    previousPrice = 2475.00
}

object "holding : Holding" as holding {
    quantity = 15
    averagePrice = 2400.00
}

object "order : Order" as order {
    orderId = 9001
    type = BUY
    quantity = 10
