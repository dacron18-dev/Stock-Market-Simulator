@startuml

object "rahul : Trader" as trader {
    traderId = 101
    name = "Rahul"
    email = "rahul@example.com"
}

object "account : Account" as account {
    accountId = 501
    cashBalance = 25000.00
}

object "portfolio : Portfolio" as portfolio {
    portfolioId = 701
    totalValue = 37500.00
}

object "reliance : Stock" as stock {
